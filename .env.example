# Copy to .env and adjust. Never commit .env — it is git-ignored.
# Every value below is a placeholder; none of them are real credentials.

# --- Runtime -----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# --- PostgreSQL --------------------------------------------------------------
# Host port 5433 matches docker-compose.yml (non-default to avoid collisions).
DATABASE_URL=postgresql://physio:physio@localhost:5433/physio?schema=public

# Credentials the docker-compose postgres service is created with. Change these
# together with DATABASE_URL. Local development values only.
POSTGRES_USER=physio
POSTGRES_PASSWORD=physio
POSTGRES_DB=physio

# --- Redis -------------------------------------------------------------------
# Host port 6380 matches docker-compose.yml (non-default to avoid collisions).
REDIS_URL=redis://localhost:6380

# --- CORS --------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Empty means no cross-origin
# browser client is permitted. First entry is the public website, second the CRM.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Auth --------------------------------------------------------------------
# Signing key for CRM access tokens. Minimum 32 characters. Generate a fresh
# random value per environment: `openssl rand -base64 48`. Rotating it signs
# every active session out.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
# Access-token lifetime (seconds). ~15 minutes per TRD §7.2.
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime (seconds). 30 days.
JWT_REFRESH_TTL_SECONDS=2592000

# Google OAuth client ID the CRM signs in with, and the `aud` claim every
# incoming ID token is checked against. Empty until a Google Cloud OAuth client
# exists — while empty, POST /auth/google rejects every request.
GOOGLE_OAUTH_CLIENT_ID=

# Signing key for reschedule links (GET /appointments/reschedule/:token).
# Minimum 32 characters. Kept separate from JWT_ACCESS_SECRET because these
# tokens are handed to unauthenticated patients over WhatsApp/SMS — a
# materially different exposure than a CRM bearer token.
RESCHEDULE_TOKEN_SECRET=replace-me-with-at-least-32-random-characters
# Reschedule-link lifetime (seconds). 14 days.
RESCHEDULE_TOKEN_TTL_SECONDS=1209600

# TEMPORARY DEV BYPASS — see EXECUTION-PLAN decision B6.
# When true (and NODE_ENV is not production) POST /api/v1/auth/dev-login is
# registered and issues a real session for any active user in `users`, without
# proving identity. The application refuses to boot if this is true while
# NODE_ENV=production. Must be removed before any deployment.
AUTH_DEV_BYPASS=true

# --- Seed data ---------------------------------------------------------------
# Accounts `npm run db:seed` creates. Local development values only.
SEED_DOCTOR_EMAIL=doctor@physioclinic.local
SEED_DOCTOR_PASSWORD=ChangeMe!Local123
SEED_STAFF_EMAIL=staff@physioclinic.local
