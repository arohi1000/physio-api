# Copy to .env and adjust. Never commit .env — it is git-ignored.
# Every value below is a placeholder; none of them are real credentials.

# --- Runtime -----------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# --- PostgreSQL --------------------------------------------------------------
# Host port 5433 matches docker-compose.yml (non-default to avoid collisions).
DATABASE_URL=postgresql://physio:physio@localhost:5433/physio?schema=public

# Credentials the docker-compose postgres service is created with. Change these
# together with DATABASE_URL. Local development values only.
POSTGRES_USER=physio
POSTGRES_PASSWORD=physio
POSTGRES_DB=physio

# --- Redis -------------------------------------------------------------------
# Host port 6380 matches docker-compose.yml (non-default to avoid collisions).
REDIS_URL=redis://localhost:6380

# --- CORS --------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Empty means no cross-origin
# browser client is permitted. First entry is the public website, second the CRM.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
